# =============================================================================
# DeskcommCRM — Variáveis de Ambiente de Staging (Homologação Isolada)
# =============================================================================
# Copie para .env.staging na VPS de homologação e preencha com as credenciais
# exclusivas do ambiente de testes. NUNCA utilizar credenciais de produção.
# =============================================================================

# --- Domínio e Certificado SSL (Caddy) ---------------------------------------
DOMAIN=staging.zyroncrm.tech
ACME_EMAIL=admin@staging.zyroncrm.tech

# --- URLs da Aplicação -------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://staging.zyroncrm.tech
NEXT_PUBLIC_ADMIN_URL=https://staging.zyroncrm.tech

# --- Supabase Staging --------------------------------------------------------
# URL pública da API do Supabase de staging (ex: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
# Anon key do Supabase de staging (segura para o browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...<staging_anon_key_placeholder>
# Service role key do Supabase de staging — Bypassa RLS (apenas servidor)
SUPABASE_SERVICE_ROLE_KEY=ey...<staging_service_role_key_placeholder>

# --- Banco de Dados Postgres (Supabase Staging) ------------------------------
# ATENÇÃO CRÍTICA À PORTA:
# Use OBRIGATORIAMENTE a PORTA 5432 (Session Pooler ou Direct Connection).
# NÃO use a porta 6543 (Transaction Pooler / PgBouncer), pois o modo transaction
# quebra DDL (create extension/tables/policies), migrations e locks do worker.
#
# Formato IPv4 (Session Pooler - Porta 5432):
# postgresql://postgres.<staging-project-ref>:<staging-password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Formato Direct Connection (Porta 5432):
# postgresql://postgres:<staging-password>@db.<staging-project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<staging-project-ref>:<staging-password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.<staging-project-ref>:<staging-password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_ADMIN_URL=

# --- Segredos Internos e Crons -----------------------------------------------
# Gerar segredos fortes: openssl rand -hex 32
INTERNAL_SECRET=<openssl_rand_hex_32_placeholder>
INTERNAL_CRON_SECRET=<openssl_rand_hex_32_placeholder>
TENANT_PROVISIONING_SECRET=

# --- Follow-up Flow: Node IA Conversacional (Ativo para Homologação) ----------
FOLLOWUP_AI_NODE_ENABLED=true

# --- WAHA (WhatsApp HTTP API) ------------------------------------------------
WAHA_API_BASE_URL=http://localhost:3000
# Plaintext da API key do WAHA enviada pelo app no header X-Api-Key
WAHA_API_KEY=<plaintext_waha_api_key_staging>
# Hash SHA-512 hex da WAHA_API_KEY acima (o container WAHA compara com este hash)
# Gerar: printf "%s" "$WAHA_API_KEY" | sha512sum | awk '{print $1}'
WAHA_API_KEY_SHA512=<sha512_hex_da_waha_api_key_acima>
# Segredo HMAC para assinatura dos webhooks do WAHA: openssl rand -hex 32
WAHA_HMAC_SECRET=<openssl_rand_hex_32_placeholder>
# WAHA Core não assina webhooks por padrão; manter false equivalente à produção
WAHA_WEBHOOK_REQUIRE_SIGNATURE=false
WAHA_WEBHOOK_BASE_URL=https://staging.zyroncrm.tech
WHATSAPP_DEFAULT_ENGINE=NOWEB
WHATSAPP_RESTART_ALL_SESSIONS=True

# --- Redis Efêmero / SRH ----------------------------------------------------
# Token para comunicação entre app e srh: openssl rand -hex 32
SRH_TOKEN=<openssl_rand_hex_32_placeholder>
UPSTASH_REDIS_REST_URL=http://srh:8079
UPSTASH_REDIS_REST_TOKEN=<mesmo_valor_de_srh_token>

# --- Provedores de IA (Preencher o provider usado no teste) ------------------
# Anthropic (para agente Claude em homologação)
ANTHROPIC_API_KEY=
# OpenAI (para embeddings e agente GPT em homologação)
OPENAI_API_KEY=
# Gateway / OpenRouter opcionais
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
VERCEL_AI_GATEWAY_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# --- Chaves de Criptografia de Dados (AES-256) -------------------------------
# Chave AES-256 (32 bytes em base64): openssl rand -base64 32
AI_CRED_AES_KEY=<openssl_rand_base64_32_placeholder>
# Chave para CPF / PII: openssl rand -hex 32
CPF_ENCRYPTION_KEY=<openssl_rand_hex_32_placeholder>
# Chave de cookie impersonate: openssl rand -hex 32
IMPERSONATE_COOKIE_SECRET=<openssl_rand_hex_32_placeholder>
# Assinatura LGPD: openssl rand -hex 32
LGPD_SIGNING_KEY=<openssl_rand_hex_32_placeholder>
WAHA_BYO_ENCRYPTION_KEY=
NUVEMSHOP_OAUTH_ENCRYPTION_KEY=

# --- E-mail e Suporte --------------------------------------------------------
SUPPORT_EMAIL=suporte@staging.zyroncrm.tech
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Configurações da Instalação ---------------------------------------------
APP_NAME="Deskcomm Staging Lab"
APP_LOCALE=pt-BR
SIGNUP_MODE=so_convite
AGENT_DISPATCH_CONSUMER=engine
AI_BUDGET_ENFORCEMENT=on
AI_ALLOWLIST_TTL_DAYS=21
INTERNAL_AGENT_RUN_STUB=false
EVENT_LOG_DRAIN_INTERVAL_MS=2000
EVENT_LOG_DRAIN_IDLE_INTERVAL_MS=10000
EVENT_LOG_DRAIN_BATCH_SIZE=50
